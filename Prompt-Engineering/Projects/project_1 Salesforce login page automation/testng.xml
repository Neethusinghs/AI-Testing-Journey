<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SalesforceLoginSuite" verbose="1" thread-count="1">
    <listeners>
        <listener class-name="com.salesforce.automation.listeners.TestListener"/>
